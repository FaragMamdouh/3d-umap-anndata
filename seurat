DefaultAssay(filltered2) = "integrated"
filltered2 <- RunUMAP(
  filltered2,
  dims = 1:30,
  n.components = 3,
  reduction.name = "umap3d",
  reduction.key = "UMAP3D_"
)

# extract embeddings
emb <- Embeddings(filltered2, "umap3d")


cluster_colors <- c(
  "5" = "#E76F51", 
  "7" = "#6D6875",
  "6" = "#CDB4DB",
  "3" = "#E9C46A", 
  "1" = "#2A9D8F",
  "2" = "#8AB17D",
  "0" = "#264653", 
  "4" = "#F4A261"
)

emb <- Embeddings(filltered2, "umap3d")
Idents(filltered2) = "integrated_snn_res.0.5"

df <- data.frame(
  UMAP1 = emb[,1],
  UMAP2 = emb[,2],
  UMAP3 = emb[,3],
  celltype = Idents(filltered2)
)
centers <- df %>%
  group_by(celltype) %>%
  summarise(
    UMAP1 = mean(UMAP1),
    UMAP2 = mean(UMAP2),
    UMAP3 = mean(UMAP3)
  )
p <- plot_ly(
  df,
  x = ~UMAP1,
  y = ~UMAP2,
  z = ~UMAP3,
  type = "scatter3d",
  mode = "markers",
  color = ~celltype,
  colors = cluster_colors,
  marker = list(size = 2)
)

p <- add_trace(
  p,
  data = centers,
  x = ~UMAP1,
  y = ~UMAP2,
  z = ~UMAP3,
  type = "scatter3d",
  mode = "text",
  text = ~celltype,
  textfont = list(size = 14, color = "black"),
  showlegend = FALSE
)

p
library(htmlwidgets)

saveWidget(
  widget = p,
  file = "umap3d.html",
  selfcontained = TRUE
)
